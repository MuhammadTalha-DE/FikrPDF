# App
APP_NAME=FikrPDF
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=30

# Logging
LOG_LEVEL=INFO

# Database (Phase 5)
DATABASE_URL=# Database (Phase 5)
DATABASE_URL=postgresql+psycopg://postgres:Talha1234%23@localhost:5432/fikrpdf

# Storage
STORAGE_PATH=./storage
CLEANUP_INTERVAL_MINUTES=15